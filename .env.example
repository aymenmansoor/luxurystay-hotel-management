MONGODB_URI=mongodb://127.0.0.1:27017/luxurystay?replicaSet=rs0
PORT=3001
# APP_ORIGIN=https://your-hotel.example
# DEMO_PASSWORD=choose-a-local-password-at-least-12-characters
# Optional email sender. APP_ORIGIN must match the site that opens links.
# MAIL_FROM=LuxuryStay <reservations@your-hotel.example>
# SMTP_URL=smtps://username:password@smtp.your-hotel.example:465
# Optional. Leave unset for direct/local access. Specify only the known proxy hops.
# TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
# Booking hold expiry in minutes. The supported range is 1–30.
# BOOKING_HOLD_MINUTES=15
# Writable persistent directory for uploaded property media.
# MEDIA_DIRECTORY=/var/lib/luxurystay/media
